--- !u!114 &78234852
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 78234851}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e22c6b426a2a14b40b0c9104d1d6a8a5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HistorietaManager
  panelImagen: {fileID: 489564616}
  panelTexto: {fileID: 2083138889}
  btnSiguiente: {fileID: 1843590972}
  paneles:
  - {fileID: 21300000, guid: fb1a89f82e86ec54a8a08459ed4d759a, type: 3}
  - {fileID: 21300000, guid: 7cd7e7ab0143463499e692c032bc48cd, type: 3}
  - {fileID: 21300000, guid: dfdf52cfde38a2b46962e62faacac7bd, type: 3}
  - {fileID: 21300000, guid: b75e096820baa984bb56cd57628f8b74, type: 3}
  - {fileID: 21300000, guid: 995a1dc68ef6d2648a9e2c0877a51d31, type: 3}
  - {fileID: 21300000, guid: 1cf915694ccd0c44f98a685b0097f9c8, type: 3}
  textos:
  - "Guerrero: \xAB\xA1Miren eso! \xA1El Torneo de los Campeones!\xBB\n\nMago: \xAB\xBFEl
    evento que se celebra una vez al a\xF1o?\xBB\n\nCl\xE9rigo: \xABEse mismo. Y
    dicen que el premio de este a\xF1o es enorme.\xBB"
  - "Guerrero: \xAB\xA1Diez mil monedas de oro para el equipo ganador!\xBB\n\nMago:
    \xABDiez mil\u2026\xBB\n\nCl\xE9rigo: \xABPodr\xEDamos vivir c\xF3modamente durante
    a\xF1os.\xBB\n\nGuerrero: \xABO comprarme una espada nueva.\xBB\n\nMago: \xABSab\xEDa
    que dir\xEDas eso.\xBB"
  - "Guerrero: \xAB\xBFQu\xE9 esperamos? \xA1Tenemos que inscribirnos!\xBB\n\nCl\xE9rigo:
    \xAB\xBFEst\xE1s seguro? El torneo re\xFAne a los mejores guerreros del reino.\xBB\n\nMago:
    \xABY nosotros somos\u2026\xBB\n\nGuerrero: \xAB\xA1Los que van a ganar!\xBB"
  - "Mago: \xABRecuerden, tenemos que trabajar como equipo.\xBB\n\nGuerrero: \xABYo
    golpeo las cosas.\xBB\n\nCl\xE9rigo: \xABYo los mantengo con vida.\xBB\n\nMago:
    \xAB\xBFY yo?\xBB\n\nGuerrero: \xABT\xFA haces magia.\xBB\n\nMago: \xAB\u2026Excelente
    estrategia.\xBB"
  - "Guerrero: \xAB\xA1Hay que prepararnos\xBB\n\nCl\xE9rigo: \xABSon muchos concursantes\xBB\n\nMago:
    \xABNo importa cu\xE1ntos sean.\xBB\n\nGuerrero: \xAB\xA1Exacto!\xBB\n\nMago:
    \xABSolo necesitamos derrotarlos antes de que ellos nos derroten.\xBB\n\nCl\xE9rigo:
    \xABEso no me tranquiliza.\xBB"
  - "Guerrero: \xABBueno\u2026 parece que llegamos a la entrada del evento\xBB\n\nCl\xE9rigo:
    \xABRecuerden por qu\xE9 estamos haciendo esto.\xBB\n\nGuerrero: \xAB\xBFPor
    el honor?\xBB\n\nMago: \xAB\xBFPor la gloria?\xBB\n\nCl\xE9rigo: \xABPor las
    diez mil monedas de oro.\xBB\n\nGuerrero: \xAB\xA1AHORA S\xCD, A GANAR!\xBB"
  nombreEscenaSiguiente: Tutorial
